apiVersion: v1
kind: ConfigMap
metadata:
  name: laravel-config
  namespace: {{ namespace }}
data:
  APP_NAME: "LaravelK8sApp"
  APP_ENV: "production"
  APP_DEBUG: "false"
  APP_URL: "http://localhost:{{ node_port }}"
  DB_CONNECTION: "mysql"
  DB_HOST: "mysql"
  DB_PORT: "3306"
  DB_DATABASE: "{{ db_name }}"
  DB_USERNAME: "{{ db_user }}"
  SESSION_DRIVER: "cookie"
  CACHE_STORE: "file"
  QUEUE_CONNECTION: "sync"
  LOG_CHANNEL: "stderr"
---
apiVersion: v1
kind: Secret
metadata:
  name: laravel-secret
  namespace: {{ namespace }}
type: Opaque
stringData:
  APP_KEY: "{{ app_key }}"
  DB_PASSWORD: "{{ db_password }}"
  MYSQL_PASSWORD: "{{ db_password }}"
  MYSQL_ROOT_PASSWORD: "{{ db_root_password }}"
